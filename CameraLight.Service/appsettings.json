{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "WindowDetection": {
    "RegularExpressions": [
      "^Huddle:.*Slack",
      "Zoom Meeting",
      "^(?!Chat|Activity).* \\| Microsoft Teams$"
    ],
    "IncludeInvisibleWindows": true
  },
  "IndicatorLight": {
    "BaseUrl": "http://192.168.0.52/color/0",
    "On": "?turn=on&red=255&green=0&blue=0&gain=10",
    "Off": "?turn=off",
    "Username": "admin",
    "Password": "password"
  },
  "StateManager": {
    "DelayMilliseconds": 5000
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.File", "Serilog.Sinks.Console" ],
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "c:\\logs\\cameralight\\cameralight-service.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      },
      {
        "Name": "Console"
      }
    ]
  }
}
